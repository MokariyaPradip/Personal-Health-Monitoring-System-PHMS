################################################################################
# PHMS Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control (add to .gitignore)
################################################################################

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================

# Flask environment (development, production, testing)
# CRITICAL: Set to 'production' for production deployments
FLASK_ENV=development

# Enable Flask debug mode (disable in production!)
# Controls auto-reload, detailed error pages, interactive debugger
# CRITICAL: Set to 0 for production
FLASK_DEBUG=1

# Secret key for session encryption
# CRITICAL: Generate a strong random key for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production: Use a cryptographically secure random 32+ character string
SECRET_KEY=dev-secret-key-change-in-production

# Additional password hashing salt
# CRITICAL: Different from SECRET_KEY, use 32+ characters
SECURITY_PASSWORD_SALT=dev-password-salt-change-in-production


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database URL (SQLite is default for development)
# Development: sqlite:///phms.db (relative path)
# Production: postgresql://user:password@localhost/phms_db
DATABASE_URL=sqlite:///phms.db


# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================

# SMTP server hostname
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# Other: your-mail-server.com
MAIL_SERVER=smtp.gmail.com


# ============================================================================
# REDIS CONFIGURATION (Rate Limiting Storage)
# ============================================================================

# Redis connection for Flask-Limiter storage backend
# Production: Configure Redis for distributed rate limiting
# Development: Optional - falls back to in-memory storage if not configured

# Option 1: Full Redis URL (recommended)
# Format: redis://[password@]host:port/db
# Example: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Option 2: Component-based configuration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Note: In-memory storage is used if Redis is unavailable (development only).
# For production, Redis is strongly recommended for multi-server deployments.

# SMTP server port (usually 587 for TLS, 465 for SSL)
MAIL_PORT=587

# Use TLS encryption for SMTP connection (recommended)
MAIL_USE_TLS=1

# Use SSL encryption for SMTP connection
# Set to 1 only if MAIL_PORT=465, otherwise set to 0
MAIL_USE_SSL=0

# SMTP authentication username (usually your email)
MAIL_USERNAME=your_email@example.com

# SMTP authentication password (use app-specific password for Gmail)
# For Gmail: Create App Password at https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your_app_password_here

# Default sender email address (can match MAIL_USERNAME)
MAIL_DEFAULT_SENDER=PHMS - Your Health Monitoring System <no-reply@phms.com>

# Suppress actual email sending (useful for testing)
# Set to 1 to prevent actual email delivery (logs instead)
MAIL_SUPPRESS_SEND=0


# ============================================================================
# SESSION SECURITY CONFIGURATION
# ============================================================================

# Cookie SameSite policy (Lax, Strict, None)
# Lax: Default, good balance of security and usability
# Strict: Maximum security, may break some workflows
# None: Allows cross-site; requires HTTPS and Secure flag
SESSION_COOKIE_SAMESITE=Lax

# Enable Secure flag for cookies (HTTPS only)
# Must be 1 in production (requires HTTPS)
# Set to 0 for local development without HTTPS
SESSION_COOKIE_SECURE=0


# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Rate limit storage backend (memory, redis, memcache)
# memory: In-process storage (good for single-server development)
# redis: Distributed rate limiting (required for multi-server production)
RATELIMIT_STORAGE_URL=memory://

# Per-IP rate limit for authentication endpoints (auth requests per minute)
# Examples: "5 per minute", "10 per minute", "100 per hour"
RATELIMIT_AUTH_ATTEMPTS=5 per minute

# Per-IP rate limit for password reset (requests per hour)
RATELIMIT_PASSWORD_RESET=3 per hour

# Per-IP rate limit for registration (requests per hour)
RATELIMIT_REGISTRATION=5 per hour


# ============================================================================
# HTTPS/TLS CONFIGURATION
# ============================================================================

# Force HTTPS redirects in production
# Set to 1 to redirect all HTTP to HTTPS (requires HTTPS server)
FORCE_HTTPS=0

# Enable HTTP Strict-Transport-Security header (HSTS)
# Tells browsers to use HTTPS only
# Max age in seconds: 31536000 = 1 year
HSTS_MAX_AGE=31536000

# Include subdomains in HSTS policy
HSTS_INCLUDE_SUBDOMAINS=1

# Allow browser to preload HSTS (added to Chrome preload list)
HSTS_PRELOAD=1


# ============================================================================
# SECURITY HEADERS
# ============================================================================

# Content Security Policy (CSP) header
# Controls which resources can be loaded (scripts, styles, images, etc.)
# This is a strict but functional policy for the PHMS application
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self';

# Referrer Policy
# Controls how much referrer information is sent
# strict-origin-when-cross-origin: Safe default
REFERRER_POLICY=strict-origin-when-cross-origin

# Permissions Policy (formerly Feature Policy)
# Controls which browser features can be used
PERMISSIONS_POLICY=accelerometer=(), ambient-light-sensor=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()


# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment name for logging and monitoring
# Used to differentiate between environments
ENVIRONMENT_NAME=development

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable API access for external clients
# Set to 1 to enable, 0 to disable
ENABLE_API=0

# Maximum file upload size (in bytes)
# 10 MB = 10485760
MAX_UPLOAD_SIZE=10485760
